# Copie ce fichier en ".env" et adapte les valeurs à ta config.
# Ne mets JAMAIS le fichier ".env" (avec tes vrais identifiants) sur GitHub.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sainte_famille
DB_USER=root
DB_PASS=

# Chaîne secrète utilisée pour signer les tokens JWT.
# Change-la par une longue chaîne aléatoire avant la mise en production.
JWT_SECRET=change_moi_en_une_longue_chaine_secrete
JWT_EXPIRY_SECONDS=3600

# Mets à "false" en production : true affiche les erreurs PHP détaillées
# (message SQL, stack trace) directement dans la réponse HTTP.
APP_DEBUG=true

# Laisse vide si public/ est directement la racine web de l'hébergement
# (cas normal en production). Renseigne un préfixe seulement si l'API est
# servie depuis un sous-dossier, ex. sur XAMPP : /Sainte_Famille/public
APP_BASE_PATH=

# Origine autorisée à appeler l'API en CORS (app Flutter Web, back-office...).
# "*" en développement ; restreins à l'URL exacte de l'app en production,
# ex. https://app.saintefamille.example.com
CORS_ALLOW_ORIGIN=*
